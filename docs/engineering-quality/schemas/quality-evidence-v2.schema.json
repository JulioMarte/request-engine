{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://request-engine.local/schemas/quality-evidence-v2.schema.json",
  "title": "Request Engine Quality Evidence Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "classification",
    "trigger_ids",
    "repository",
    "base_sha",
    "source_head_sha",
    "tested_sha",
    "test_mode",
    "scope",
    "facts",
    "deltas",
    "architecture_results",
    "context_manifest",
    "review_questions",
    "provenance",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "quality-evidence/v2"},
    "candidate_id": {"type": "string", "pattern": "^QR-[a-f0-9]{12}$"},
    "classification": {"const": "REVIEW_CANDIDATE"},
    "trigger_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^QR-[A-Z]+-[0-9]{3}$"}
    },
    "repository": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tested_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "test_mode": {"enum": ["PR_INTEGRATION_CANDIDATE", "BRANCH_HEAD"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "subject"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "module": {"type": ["string", "null"]}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject", "value", "tool", "interpretation"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "value": {"type": ["integer", "number", "string", "boolean", "null"]},
          "tool": {"type": "string", "minLength": 1},
          "interpretation": {"const": "none"}
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "before", "after", "delta"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "before": {"type": ["integer", "number", "null"]},
          "after": {"type": ["integer", "number"]},
          "delta": {"type": ["integer", "number", "null"]}
        }
      }
    },
    "architecture_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fitness_id", "status", "source"],
        "properties": {
          "fitness_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skip", "not_run", "timeout"]},
          "source": {"type": "string", "minLength": 1},
          "details": {"type": ["string", "null"]}
        }
      }
    },
    "context_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_schema",
        "baseline_schema",
        "baseline_sha",
        "architecture_diff_schema",
        "tools"
      ],
      "properties": {
        "scan_schema": {"type": "string", "minLength": 1},
        "baseline_schema": {"const": "engineering-quality-baseline/v1"},
        "baseline_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "architecture_diff_schema": {"const": "architecture-diff/v1"},
        "tools": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "authority": {"const": "heuristic-signals-are-non-blocking"}
  }
}
