FROM python:3.13-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        git \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install uv==0.12.5

WORKDIR /workspace
