    "canonicalization": {
      "reason": "installation-local identity must be generated independently for every fresh installation",
      "changes": [
        "built-in native/workload identity-authority UUIDs use table defaults instead of copied source values",
        "platform_instance references the freshly generated built-in authorities",
        "installation-local creation timestamps use PostgreSQL defaults instead of copied source timestamps",
        "COMMENT ON EXTENSION is omitted because CREATE EXTENSION recreates the extension's own comment",
        "four leftmost length(x) >= a AND length(x) <= b CHECK conjuncts are restored to their original BETWEEN source form so replay reproduces the exact stored expression tree"
      ],
