REQUEST_ENGINE_ENV=development
DATABASE_URL=postgresql+asyncpg://request_engine:request_engine@localhost:5432/request_engine
MIGRATION_DATABASE_URL=postgresql+psycopg://request_engine:request_engine@localhost:5432/request_engine

# Local OpenTelemetry Collector defaults. Production overrides these at deployment.
OTEL_SERVICE_NAME=request-engine-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=false

# Optional governed identity-recovery delivery (private control plane + worker).
# Both sides are required together; absence fails closed (503 recovery_delivery_unconfigured).
# REQUEST_ENGINE_RECOVERY_DELIVERY_FACTORY=my.deployment:build_delivery
# REQUEST_ENGINE_VAULT_ADDR=https://vault.internal:8200
# REQUEST_ENGINE_VAULT_TOKEN=...
# REQUEST_ENGINE_VAULT_NAMESPACE=
# REQUEST_ENGINE_VAULT_MOUNT=secret
# REQUEST_ENGINE_VAULT_PATH_PREFIX=request-engine/identity-recovery
# REQUEST_ENGINE_SMTP_HOST=mail.internal
# REQUEST_ENGINE_SMTP_PORT=587
# REQUEST_ENGINE_SMTP_USERNAME=
# REQUEST_ENGINE_SMTP_PASSWORD=
# REQUEST_ENGINE_SMTP_SENDER=noreply@example.com
# REQUEST_ENGINE_SMTP_STARTTLS=true
# REQUEST_ENGINE_SMTP_SSL=false
# REQUEST_ENGINE_RECOVERY_RESET_URL=https://app.example.com/recover
