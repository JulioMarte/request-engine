REQUEST_ENGINE_ENV=development
DATABASE_URL=postgresql+asyncpg://request_engine:request_engine@localhost:5432/request_engine
MIGRATION_DATABASE_URL=postgresql+psycopg://request_engine:request_engine@localhost:5432/request_engine

# Local OpenTelemetry Collector defaults. Production overrides these at deployment.
OTEL_SERVICE_NAME=request-engine-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=false
